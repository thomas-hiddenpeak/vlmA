# Nginx 配置示例 - HTTPS (摄像头必需)
# 文件位置: /etc/nginx/sites-available/rminte-ssl

# HTTP 重定向到 HTTPS
server {
    listen 80;
    server_name your-domain.com;  # 修改为你的域名
    return 301 https://$server_name$request_uri;
}

# HTTPS 配置
server {
    listen 443 ssl http2;
    server_name your-domain.com;  # 修改为你的域名

    # SSL 证书配置 (使用 Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    
    # SSL 安全配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 日志
    access_log /var/log/nginx/rminte-ssl-access.log;
    error_log /var/log/nginx/rminte-ssl-error.log;

    # 代理到 Node.js 应用
    location / {
        proxy_pass http://localhost:43003;
        proxy_http_version 1.1;
        
        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时设置 (SSE 需要较长超时)
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # 缓存控制
        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;  # 对 SSE 很重要
        
        # 大文件上传支持
        client_max_body_size 50M;
    }

    # 健康检查
    location /health {
        proxy_pass http://localhost:43003/health;
        access_log off;
    }
}

# ========================================
# Let's Encrypt 证书获取步骤:
# ========================================
#
# 1. 安装 Certbot
#    sudo apt update
#    sudo apt install certbot python3-certbot-nginx
#
# 2. 获取证书
#    sudo certbot --nginx -d your-domain.com
#
# 3. 自动续期测试
#    sudo certbot renew --dry-run
#
# 4. 启用配置
#    sudo ln -s /etc/nginx/sites-available/rminte-ssl /etc/nginx/sites-enabled/
#    sudo nginx -t
#    sudo systemctl reload nginx
#
